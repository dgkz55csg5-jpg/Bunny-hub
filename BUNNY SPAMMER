-- 🐰 BUNNY SPAMMER
-- BLUE × BLACK GUI

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "BunnySpammer"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 280, 0, 340)
main.Position = UDim2.new(0.5, -140, 0.5, -170)
main.BackgroundColor3 = Color3.fromRGB(10, 18, 32)
main.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = main

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.BackgroundColor3 = Color3.fromRGB(20, 75, 140)
title.Text = "🐰 BUNNY SPAMMER"
title.TextColor3 = Color3.new(1,1,1)
title.TextSize = 19
title.Font = Enum.Font.GothamBold
title.Parent = main

local function createButton(text, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.9, 0, 0, 35)
    b.Position = UDim2.new(0.05, 0, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(25, 65, 115)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = text
    b.TextSize = 14
    b.Font = Enum.Font.GothamBold
    b.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = b

    return b
end

local target = Instance.new("TextBox")
target.Size = UDim2.new(0.9, 0, 0, 35)
target.Position = UDim2.new(0.05, 0, 0, 60)
target.PlaceholderText = "Target Name"
target.Text = ""
target.Parent = main

local on = createButton("SPAMMER ON", 105)
local off = createButton("SPAMMER OFF", 145)
local slow = createButton("🐢 SPAM SLOW", 185)
local fast = createButton("⚡ SPAM FAST", 225)
local symbols = createButton("@  &  #  $", 265)

local enabled = false

on.MouseButton1Click:Connect(function()
    enabled = true
end)

off.MouseButton1Click:Connect(function()
    enabled = false
end)

slow.MouseButton1Click:Connect(function()
    print("Slow mode selected")
end)

fast.MouseButton1Click:Connect(function()
    print("Fast mode selected")
end)

symbols.MouseButton1Click:Connect(function()
    print("@ & # $")
end)

print("BUNNY 🐰 SPAMMER LOADED 🥶🙏🔥")
